<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy-by-Design: nothing leaves the device — no cloud backup, no
  device-to-device transfer. The requirements doc forbids storing or
  transmitting user data beyond what the user explicitly sends, so every
  domain is excluded for both cloud backup and device transfer.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
