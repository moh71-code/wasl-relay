<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy-by-Design (Android 12+): block ALL data extraction — cloud backup
  and device-to-device transfer. Chat history, keys and local settings must
  never leave the user's device through OS-level backup channels.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
